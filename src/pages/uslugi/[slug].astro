---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Clients from '../../components/Clients.astro';
import ServiceHeroVisual from '../../components/ServiceHeroVisual.astro';
import { servicesData, type ServiceData } from '../../data/services';
import { getAssetUrl } from '../../utils/paths';

export function getStaticPaths() {
  return Object.keys(servicesData).map((slug) => ({
    params: { slug },
    props: { service: servicesData[slug] }
  }));
}

interface Props {
  service: ServiceData;
}

const { service } = Astro.props;
const siteUrl = Astro.site ?? 'https://Purks1337.github.io';
const currentUrl = new URL(getAssetUrl(`/uslugi/${service.slug}/`), siteUrl).href;
const catalogUrl = new URL(getAssetUrl('/uslugi/'), siteUrl).href;
const homeUrl = new URL(getAssetUrl('/'), siteUrl).href;

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": homeUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Услуги",
      "item": catalogUrl
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.h1,
      "item": currentUrl
    }
  ]
};

// Service Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.h1,
  "serviceType": service.schemaType,
  "description": service.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Хвалите Media",
    "image": new URL(getAssetUrl('/assets/img/showreel.jpg'), siteUrl).href,
    "telephone": "+79923410520",
    "email": "hvaliteq@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "ул. Ботаническая, 19",
      "addressLocality": "Екатеринбург",
      "addressRegion": "Свердловская область",
      "addressCountry": "RU"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Екатеринбург" },
    { "@type": "AdministrativeArea", "name": "Свердловская область" },
    { "@type": "Country", "name": "Россия" }
  ],
  "url": currentUrl
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": service.faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

// Related services data
const relatedServices = service.relatedSlugs
  .map(slug => servicesData[slug])
  .filter(Boolean);
---

<Layout
  title={service.title}
  description={service.description}
  ogTitle={service.ogTitle}
  ogDescription={service.ogDescription}
  canonicalUrl={currentUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main class="service-page">
    <!-- Breadcrumbs -->
    <div class="bc-bar">
      <div class="wrap">
        <nav aria-label="Хлебные крошки" class="bc-nav">
          <a href={getAssetUrl('/')} class="bc-link">Главная</a>
          <span class="bc-sep">/</span>
          <a href={getAssetUrl('/uslugi/')} class="bc-link">Услуги</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{service.h1}</span>
        </nav>
      </div>
    </div>

    <!-- 01. Первый экран #top -->
    <section id="top" class="s-hero">
      <div class="wrap s-hero-grid">
        <div class="s-hero-content">
          <div class="s-hero-tag">
            <span class="tag-num">{service.num}</span>
            <span class="tag-badge">{service.badge}</span>
          </div>

          <h1 id="hero-h1" class="s-hero-title">{service.h1}</h1>

          <p id="hero-sub" class="s-hero-sub">{service.sub}</p>

          <ul class="s-benefits">
            {service.benefits.map((b) => (
              <li class="s-benefit-item">
                <svg class="s-star-icon" viewBox="0 0 200 200" width="18" height="18" aria-hidden="true">
                  <polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#3358F4" stroke="#3358F4" stroke-width="8"></polygon>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="s-hero-actions">
            <a href="#zayavka" class="btn-primary">Рассчитать смету</a>
            <a href="#kejsy" class="btn-secondary">Смотреть кейсы</a>
          </div>

          <div class="s-trust-bar">
            <span class="s-trust-label">КЛИЕНТЫ:</span>
            <span class="s-trust-text">{service.trustText}</span>
          </div>
        </div>

        <div class="s-hero-visual-col">
          <ServiceHeroVisual figure={service.heroFigure} />
        </div>
      </div>
    </section>

    <!-- 02. Задачи и форматы #formaty -->
    <section id="formaty" class="sec sec-light">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label">02 · ЗАДАЧИ И ФОРМАТЫ</span>
            <h2 class="sec-title">{service.formatsTitle}</h2>
          </div>
          <p class="sec-intro">{service.formatsIntro}</p>
        </div>

        <div class="formats-grid">
          {service.formats.map((f, idx) => (
            <div class="format-card">
              <span class="format-num">0{idx + 1}</span>
              <h3 class="format-title">{f.title}</h3>
              <p class="format-desc">{f.desc}</p>
            </div>
          ))}
        </div>

        <!-- Honest Section for AI if present -->
        {service.honestSection && (
          <div class="honest-block">
            <div class="honest-head">
              <h3 class="honest-title">{service.honestSection.title}</h3>
              <p class="honest-intro">{service.honestSection.intro}</p>
            </div>
            <div class="honest-table">
              <div class="honest-row honest-header-row">
                <div class="honest-col-ai">Нейросети хорошо делают</div>
                <div class="honest-col-human">Здесь без людей не обойтись</div>
              </div>
              {service.honestSection.rows.map(r => (
                <div class="honest-row">
                  <div class="honest-col-ai"><span class="badge-ai">AI</span> {r.ai}</div>
                  <div class="honest-col-human"><span class="badge-human">Команда</span> {r.human}</div>
                </div>
              ))}
            </div>
            <p class="honest-conclusion">{service.honestSection.conclusion}</p>
          </div>
        )}

        {service.formatNotes && service.formatNotes.length > 0 && (
          <div class="cross-hints">
            {service.formatNotes.map(n => (
              <div class="cross-hint-item">
                <span>{n.text}</span>
                <a href={n.url.startsWith('http') ? n.url : getAssetUrl(n.url)} class="cross-hint-link">
                  {n.linkText}
                </a>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- 03. Цены и смета #ceny -->
    <section id="ceny" class="sec sec-dark">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label sec-num-gold">03 · ЦЕНЫ</span>
            <h2 class="sec-title sec-title-light">{service.pricingTitle}</h2>
          </div>
          <p class="sec-intro sec-intro-light">
            Прозрачная смета по сменам сразу после брифа. Вы точно знаете, за что платите.
          </p>
        </div>

        <div class="packages-grid">
          {service.packages.map((pkg, idx) => (
            <div class={`pkg-card ${idx === 1 ? 'pkg-featured' : ''}`}>
              {idx === 1 && <span class="pkg-popular-tag">ПОПУЛЯРНЫЙ ВЫБОР</span>}
              <div class="pkg-top">
                <span class="pkg-idx">ПАКЕТ 0{idx + 1}</span>
                <h3 class="pkg-name">{pkg.name}</h3>
                <div class="pkg-price">{pkg.price}</div>
              </div>

              <div class="pkg-meta">
                <div class="pkg-meta-row">
                  <span class="pkg-meta-lbl">Хронометраж:</span>
                  <span class="pkg-meta-val">{pkg.timing}</span>
                </div>
                <div class="pkg-meta-row">
                  <span class="pkg-meta-lbl">Производство:</span>
                  <span class="pkg-meta-val">{pkg.shooting}</span>
                </div>
                <div class="pkg-meta-row">
                  <span class="pkg-meta-lbl">Версии:</span>
                  <span class="pkg-meta-val">{pkg.versions}</span>
                </div>
                <div class="pkg-meta-row">
                  <span class="pkg-meta-lbl">Сроки:</span>
                  <span class="pkg-meta-val">{pkg.timeline}</span>
                </div>
              </div>

              <div class="pkg-includes">
                <span class="pkg-inc-label">Что входит:</span>
                <p class="pkg-inc-text">{pkg.includes}</p>
              </div>

              <a href="#zayavka" class="pkg-btn">Выбрать пакет</a>
            </div>
          ))}
        </div>

        <!-- Breakdown -->
        <div class="breakdown-wrap">
          <h3 class="breakdown-title">{service.costBreakdownTitle}</h3>
          <p class="breakdown-desc">
            Мы считаем стоимость по сменам специалистов и техники. В смете видно каждую строку:
          </p>
          <div class="breakdown-grid">
            {service.costBreakdownItems.map(item => (
              <div class="breakdown-card">
                <h4 class="breakdown-item-title">{item.title}</h4>
                <p class="breakdown-item-desc">{item.desc}</p>
              </div>
            ))}
          </div>
          <div class="breakdown-action">
            <a href="#zayavka" class="btn-primary">Запросить индивидуальную смету</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 04. Кейсы #kejsy (Windows 98) -->
    <section id="kejsy" class="sec sec-blue">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label sec-num-white">04 · КЕЙСЫ</span>
            <h2 class="sec-title sec-title-white">{service.casesTitle}</h2>
          </div>
          <p class="sec-intro sec-intro-white">
            Реальные работы студии. Нажмите на окно, чтобы посмотреть видео, задачу, решение и результат.
          </p>
        </div>

        <div class="cases-win-grid">
          {service.cases.map((c) => (
            <div class="win98-window">
              <!-- Window title bar -->
              <div class="win-tb">
                <div class="win-tb-title">
                  <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                    <rect x="1" y="3" width="14" height="10" fill="#E4E3DE"></rect>
                    <polygon points="6,5.5 11,8 6,10.5" fill="#3358F4"></polygon>
                  </svg>
                  <span>{c.file || 'case_player.mp4'} — Свойства</span>
                </div>
                <div class="win-tb-btns" aria-hidden="true">
                  <span class="win-btn">_</span>
                  <span class="win-btn">□</span>
                  <span class="win-btn">×</span>
                </div>
              </div>

              <!-- Menu Bar -->
              <div class="win-menubar" aria-hidden="true">
                <span>Файл</span><span>Правка</span><span>Вид</span><span>Справка</span>
              </div>

              <!-- Video Screen Placeholder -->
              <div class="win-screen">
                <div class="win-screen-overlay">
                  <span class="win-badge">{c.badge || 'ПРОЕКТ'}</span>
                  <span class="win-play-indicator">
                    <span class="rec-dot"></span> PLAY
                  </span>
                  <div class="win-center-play">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="#1B1B1B">
                      <polygon points="6,3 20,12 6,21"></polygon>
                    </svg>
                  </div>
                  <span class="win-format-tag">{c.format}</span>
                </div>
              </div>

              <!-- Details Tabs -->
              <div class="win-body">
                <h3 class="win-case-title">{c.title}</h3>

                <div class="win-field">
                  <span class="win-field-tag">ЗАДАЧА</span>
                  <p class="win-field-text">{c.task}</p>
                </div>

                <div class="win-field">
                  <span class="win-field-tag">РЕШЕНИЕ</span>
                  <p class="win-field-text">{c.solution}</p>
                </div>

                <div class="win-field win-field-result">
                  <span class="win-field-tag">РЕЗУЛЬТАТ</span>
                  <p class="win-field-text">{c.result}</p>
                </div>

                <div class="win-actions">
                  <a href="#zayavka" class="win-action-btn win-btn-accent">Обсудить такой же</a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="nda-notice">
          <span class="nda-icon">🔒</span>
          <span>Часть коммерческих проектов находится под NDA. Детальные презентации и кейсы показываем на личной встрече.</span>
        </div>
      </div>
    </section>

    <!-- 05. Этапы и сроки #etapy -->
    <section id="etapy" class="sec sec-light">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label">05 · ЭТАПЫ РАБОТЫ</span>
            <h2 class="sec-title">{service.stagesTitle}</h2>
          </div>
          <div class="stages-badge-pill">{service.stagesTotal}</div>
        </div>

        <div class="stages-timeline">
          {service.stages.map((st) => (
            <div class="stage-step-card">
              <div class="stage-step-header">
                <span class="stage-step-num">0{st.num}</span>
                <span class="stage-step-time">{st.time}</span>
              </div>
              <h3 class="stage-step-title">{st.title}</h3>
              <p class="stage-step-desc">{st.desc}</p>
            </div>
          ))}
        </div>

        {service.stageTip && (
          <div class="stage-tip-box">
            <span class="tip-icon">💡</span>
            <p class="tip-text">{service.stageTip}</p>
          </div>
        )}
      </div>
    </section>

    <!-- 06. Почему мы и команда #komanda -->
    <section id="komanda" class="sec sec-dark">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label sec-num-gold">06 · ПОЧЕМУ МЫ</span>
            <h2 class="sec-title sec-title-light">{service.whyUsTitle}</h2>
          </div>
        </div>

        <div class="why-us-grid">
          {service.whyUsPoints.map((pt) => (
            <div class="why-card">
              <div class="why-card-top">
                <svg width="20" height="20" viewBox="0 0 200 200" class="why-star" aria-hidden="true">
                  <polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#3358F4" stroke="#3358F4" stroke-width="8"></polygon>
                </svg>
                <h3 class="why-card-title">{pt.title}</h3>
              </div>
              <p class="why-card-desc">{pt.desc}</p>
            </div>
          ))}
        </div>

        <div class="team-block">
          <h3 class="team-block-title">КОМАНДА ПРОЕКТА</h3>
          <p class="team-block-sub">Специалисты студии, которые ведут эту услугу от первого брифа до мастера:</p>

          <div class="team-cards-grid">
            {service.teamMembers.map((m) => (
              <div class="team-mini-card">
                <div class="team-mini-avatar">
                  <svg width="36" height="36" viewBox="0 0 200 200" aria-hidden="true">
                    <polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#3358F4" stroke="#B9C6FB" stroke-width="6"></polygon>
                  </svg>
                  <span class="team-mini-3d">3D</span>
                </div>
                <div class="team-mini-info">
                  <div class="team-mini-name">{m.name}</div>
                  <div class="team-mini-role">{m.role}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 07. Клиенты #klienty -->
    <Clients />

    <!-- 08. Отзывы #otzyvy -->
    <section id="otzyvy" class="sec sec-light">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label">08 · ДОВЕРИЕ</span>
            <h2 class="sec-title">{service.reviewsTitle}</h2>
          </div>
          <div class="reviews-yandex-link">
            <a href="https://yandex.ru/maps" target="_blank" rel="noopener noreferrer" class="btn-yandex">
              ⭐ Отзывы на Яндекс Картах ↗
            </a>
          </div>
        </div>

        <div class="reviews-grid">
          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">
              «Снимали презентационный ролик для участия в федеральном конкурсе. Команда Хвалите Media взяла на себя абсолютно всё: от сценария до согласования допуска. Ролик произвёл фурор среди жюри.»
            </p>
            <div class="review-author">
              <span class="review-name">Михаил В.</span>
              <span class="review-company">Производственная компания, Екатеринбург</span>
            </div>
          </div>

          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">
              «Отличный подход к смете — всё прозрачно по сменам, никаких сюрпризов в процессе. Сдали точно в согласованный дедлайн, вертикальные нарезки для Telegram разошлись моментально.»
            </p>
            <div class="review-author">
              <span class="review-name">Елена С.</span>
              <span class="review-company">Директор по маркетингу</span>
            </div>
          </div>

          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">
              «Сложная задача была показать технологию, которую нельзя увидеть глазами. Ребята сделали великолепную графику и саунд-дизайн. Обязательно обратимся снова.»
            </p>
            <div class="review-author">
              <span class="review-name">Дмитрий К.</span>
              <span class="review-company">Руководитель проекта</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 09. FAQ #faq -->
    <section id="faq" class="sec sec-dark">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label sec-num-gold">09 · ВОПРОСЫ И ОТВЕТЫ</span>
            <h2 class="sec-title sec-title-light">{service.faqTitle}</h2>
          </div>
        </div>

        <div class="faq-list">
          {service.faqs.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-question">
                <span class="faq-q-text">{item.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
                {item.link && (
                  <p class="faq-link-p">
                    <a href={getAssetUrl(item.link.url)} class="faq-answer-link">{item.link.text}</a>
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. Экспертный текст #o-usluge -->
    <section id="o-usluge" class="sec sec-light">
      <div class="wrap expert-layout">
        <div class="expert-header">
          <span class="sec-num-label">10 · ЭКСПЕРТИЗА</span>
          <h2 class="expert-title">{service.expertH2}</h2>
        </div>

        <div class="expert-content">
          {service.expertParagraphs.map(p => (
            <p class="expert-paragraph">{p}</p>
          ))}

          {service.expertBullets && service.expertBullets.length > 0 && (
            <div class="expert-bullets-grid">
              {service.expertBullets.map(b => (
                <div class="expert-bullet-card">
                  <h4 class="expert-bullet-title">{b.title}</h4>
                  <p class="expert-bullet-desc">{b.desc}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- 11. Форма заявки #zayavka -->
    <section id="zayavka" class="sec sec-blue">
      <div class="wrap s-form-container">
        <div class="s-form-info">
          <span class="sec-num-label sec-num-white">11 · ЗАЯВКА</span>
          <h2 class="s-form-h2">{service.formH2}</h2>
          <p class="s-form-sub">{service.formSub}</p>

          <div class="s-form-contacts">
            <a href="tel:+79923410520" class="s-form-phone">+7 992 341-05-20</a>
            <div class="s-form-messengers">
              <a href="https://t.me/hvaliteq" target="_blank" rel="noopener noreferrer" class="msg-btn">Telegram</a>
              <a href="https://wa.me/79923410520" target="_blank" rel="noopener noreferrer" class="msg-btn">WhatsApp</a>
              <a href="mailto:hvaliteq@gmail.com" class="msg-btn">Email</a>
            </div>
            <div class="s-form-reply-time">
              ⚡ Ответим за 15 минут в рабочее время
            </div>
          </div>
        </div>

        <form id="lead-form" class="s-form-card" aria-label="Заявка на расчет">
          <div class="form-body" id="form-body">
            <label class="form-label">
              <span class="label-text">ИМЯ ИЛИ КОМПАНИЯ</span>
              <input type="text" name="name" class="form-input" placeholder="Как к вам обращаться" />
            </label>

            <label class="form-label">
              <span class="label-text">ТЕЛЕФОН ИЛИ TELEGRAM *</span>
              <input type="text" name="contact" required class="form-input" placeholder="+7 999 000-00-00 или @username" />
            </label>

            <div class="form-label">
              <span class="label-text">НАПРАВЛЕНИЕ ЗАДАЧИ</span>
              <div class="chips-group">
                {service.formChips.map((chip, idx) => (
                  <label class="chip-item">
                    <input type="checkbox" name="tags" value={chip} checked={idx === 0} />
                    <span class="chip-label">{chip}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="form-label">
              <span class="label-text">ОРИЕНТИР ПО БЮДЖЕТУ</span>
              <select name="budget" class="form-select">
                {service.budgetOptions.map(opt => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </div>

            <label class="form-label">
              <span class="label-text">КОММЕНТАРИЙ К ПРОЕКТУ</span>
              <textarea name="about" rows="3" class="form-textarea" placeholder="Сроки, ссылки на референсы или ключевые требования"></textarea>
            </label>

            <label class="form-checkbox-label">
              <input type="checkbox" required name="agree" checked />
              <span>Согласен на обработку персональных данных (152-ФЗ)</span>
            </label>

            <button type="submit" class="form-submit-btn">
              Рассчитать смету
            </button>
          </div>

          <div id="form-success" class="form-success-box" style="display: none;">
            <div class="success-icon">✓</div>
            <h3 class="success-title">ГОТОВО!</h3>
            <p class="success-text">Заявка передана продюсеру. Мы свяжемся с вами в течение 15 минут для уточнения сметы.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 12. Другие услуги (перелинковка) -->
    <section class="sec sec-dark">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag-group">
            <span class="sec-num-label sec-num-gold">12 · ДРУГИЕ УСЛУГИ</span>
            <h2 class="sec-title sec-title-light">Вам также может понадобиться</h2>
          </div>
          <a href={getAssetUrl('/uslugi/')} class="all-services-link">Все 6 услуг студии →</a>
        </div>

        <div class="related-grid">
          {relatedServices.map((rel) => (
            <a href={getAssetUrl(`/uslugi/${rel.slug}/`)} class="rel-card">
              <div class="rel-card-top">
                <span class="rel-num">{rel.num}</span>
                <span class="rel-badge">{rel.badge}</span>
              </div>
              <h3 class="rel-title">{rel.h1}</h3>
              <p class="rel-desc">{rel.sub}</p>
              <div class="rel-bottom">
                <span class="rel-btn">ПОДРОБНЕЕ →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- Dynamic Headline Swap Script (?h=...) -->
<script is:inline define:vars={{ swapDict: service.swapDict }}>
  (function () {
    try {
      var params = new URLSearchParams(window.location.search);
      var key = params.get('h');
      if (key && swapDict && swapDict[key]) {
        var h1El = document.getElementById('hero-h1');
        var subEl = document.getElementById('hero-sub');
        if (h1El && swapDict[key].h1) {
          h1El.textContent = swapDict[key].h1;
        }
        if (subEl && swapDict[key].sub) {
          subEl.textContent = swapDict[key].sub;
        }
      }
    } catch (e) {
      console.warn('Swap script error:', e);
    }

    // Lead form submission handling
    var form = document.getElementById('lead-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var body = document.getElementById('form-body');
        var success = document.getElementById('form-success');
        if (body && success) {
          body.style.display = 'none';
          success.style.display = 'block';
        }
        // If Yandex Metrika ym is loaded
        if (typeof window.ym === 'function') {
          try {
            window.ym(99000000, 'reachGoal', 'lead_form');
          } catch (err) {}
        }
      });
    }
  })();
</script>

