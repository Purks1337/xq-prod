---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Services from '../../components/Services.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getAssetUrl } from '../../utils/paths';

const siteUrl = Astro.site ?? 'https://Purks1337.github.io';
const pageUrl = new URL(getAssetUrl('/uslugi/'), siteUrl).href;
const homeUrl = new URL(getAssetUrl('/'), siteUrl).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": homeUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Услуги",
      "item": pageUrl
    }
  ]
};
---

<Layout
  title="Услуги видеопродакшна в Екатеринбурге — Хвалите Media"
  description="6 направлений видеопроизводства под ключ: имиджевые ролики, реклама, AI-видео, документальное кино, 3D-ролики и онлайн-трансляции. Смета по сменам."
  canonicalUrl={pageUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header />

  <main>
    <!-- Breadcrumbs -->
    <div class="bc-bar">
      <div class="wrap">
        <nav aria-label="Хлебные крошки" class="bc-nav">
          <a href={getAssetUrl('/')} class="bc-link">Главная</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">Услуги</span>
        </nav>
      </div>
    </div>

    <!-- Catalog Intro Hero -->
    <section class="catalog-hero">
      <div class="wrap">
        <div class="catalog-hero-inner">
          <span class="catalog-tag">КАТАЛОГ УСЛУГ · ХВАЛИТЕ MEDIA</span>
          <h1 class="catalog-title">УСЛУГИ ВИДЕОПРОДАКШНА</h1>
          <p class="catalog-sub">
            У каждой услуги — своя страница с подробным разбором, сметой по сменам, примерами работ в формате Windows 98 и ответами на частые вопросы. Выберите нужное направление:
          </p>
        </div>
      </div>
    </section>

    <!-- Services Grid (Reused from home with live links) -->
    <Services />

    <!-- Lead Form -->
    <LeadForm />
  </main>

  <Footer />
</Layout>

<style>
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
    width: 100%;
    box-sizing: border-box;
  }

  .bc-bar {
    background: #141414;
    border-bottom: 1px solid #2A2A2A;
    padding: 10px 0;
  }
  .bc-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }
  .bc-link {
    color: #A8A7A2;
    text-decoration: none;
    transition: color 0.15s;
  }
  .bc-link:hover {
    color: #FFFFFF;
  }
  .bc-sep {
    color: #5E5D58;
  }
  .bc-current {
    color: #E4E3DE;
    font-weight: 700;
  }

  .catalog-hero {
    background: #1B1B1B;
    color: #E4E3DE;
    padding: 64px 0 40px;
    border-bottom: 1px solid #2A2A2A;
  }
  .catalog-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 760px;
  }
  .catalog-tag {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: #D4A54C;
  }
  .catalog-title {
    margin: 0;
    font-family: 'Unbounded', 'Arial Black', sans-serif;
    font-weight: 900;
    font-size: clamp(34px, 5vw, 64px);
    line-height: 1.05;
    color: #FFFFFF;
  }
  .catalog-sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: #A8A7A2;
  }
</style>
