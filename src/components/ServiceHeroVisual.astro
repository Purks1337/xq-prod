---
interface Props {
  figure: 'rec' | 'ad' | 'ai' | 'doc' | 'cube' | 'switcher';
}

const { figure } = Astro.props;

// AI star 13x13
const SP = [[12, 12], [100, 64], [188, 12], [136, 100], [188, 188], [100, 136], [12, 188], [64, 100]];
const inStar = (x: number, y: number) => {
  let c = false;
  for (let a = 0, b = SP.length - 1; a < SP.length; b = a++) {
    const xa = SP[a][0], ya = SP[a][1], xb = SP[b][0], yb = SP[b][1];
    if ((ya > y) !== (yb > y) && x < (xb - xa) * (y - ya) / (yb - ya) + xa) c = !c;
  }
  return c;
};
const PN = 13;
const pix = [];
for (let r = 0; r < PN; r++) {
  for (let c = 0; c < PN; c++) {
    const on = inStar((c + 0.5) / PN * 200, (r + 0.5) / PN * 200);
    const h = Math.abs(Math.sin((r * PN + c + 1) * 12.9898) * 43758.5453) % 1;
    const h2 = Math.abs(Math.sin((r * PN + c + 7) * 78.233) * 12345.678) % 1;
    const delay = Math.round(Math.hypot(c - 6, r - 6) * 40);
    pix.push({
      on: on ? '1' : '0',
      st: `opacity: ${(0.25 + h * 0.7).toFixed(2)}; background: ${on || h2 > 0.55 ? '#B9C6FB' : '#3358F4'}; transition-delay: ${delay}ms; animation-delay: -${(h2 * 1.8).toFixed(2)}s`
    });
  }
}
---

<div class={`hero-visual figure-${figure}`}>
  {figure === 'rec' && (
    <div class="hfig hfig-rec">
      <span class="sun"></span>
      <svg class="sky" viewBox="0 0 1000 120" preserveAspectRatio="none">
        <path d="M0 120V82l40-22v22l40-22v22l40-22v22h30V28h14v54h40V58h60v24l40-22v22l40-22v22h40V18h14v64h30V66h80V40h22v26h40v16l40-22v22l40-22v22h40V34h14v48h50V60h60v22l40-22v22l40-22v22h30V44h14v38h62v38z" fill="#2A2A2A"></path>
      </svg>
      <span class="vc vc-tl"></span>
      <span class="vc vc-tr"></span>
      <span class="vc vc-bl"></span>
      <span class="vc vc-br"></span>
      <span class="center-cross"></span>
      <span class="iso-info">4K · 25P · ISO 800</span>
      <span class="tc-info">
        TC 00:01:24:<span class="tc-roll-wrap"><span class="tcroll">00<br>01<br>02<br>03<br>04<br>05<br>06<br>07<br>08<br>09<br>10<br>11<br>12<br>13<br>14<br>15<br>16<br>17<br>18<br>19<br>20<br>21<br>22<br>23<br>24</span></span>
      </span>
      <span class="battery-ind">
        <span></span><span></span><span></span><span class="bat-empty"></span>
      </span>
      <span class="rec-badge">
        <span class="rec-dot"></span> REC
      </span>
    </div>
  )}

  {figure === 'ad' && (
    <div class="hfig hfig-ad">
      <span class="ad-rays"></span>
      <span class="ad-dots"></span>
      <svg class="ad-ring" viewBox="0 0 240 240">
        <defs><path id="hero-ad-ring" d="M120,120 m-100,0 a100,100 0 1,1 200,0 a100,100 0 1,1 -200,0"></path></defs>
        <text fill="#1B1B1B">
          <textPath href="#hero-ad-ring" textLength="620" lengthAdjust="spacing">РЕКЛАМА, КОТОРАЯ ПРОДАЁТ ★ РЕКЛАМА, КОТОРАЯ ПРОДАЁТ ★ </textPath>
        </text>
      </svg>
      <svg class="ad-center-star" viewBox="0 0 200 200">
        <polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#1B1B1B" stroke="#1B1B1B" stroke-width="8" stroke-linejoin="round"></polygon>
      </svg>
      <span class="ad-live-badge">AD · 15″</span>
    </div>
  )}

  {figure === 'ai' && (
    <div class="hfig hfig-ai">
      <div class="ai-pixel-grid">
        {pix.map((p) => (
          <span class="px" data-on={p.on} style={p.st}></span>
        ))}
      </div>
      <div class="ai-prompt-bar">
        <span class="ai-prompt-text">&gt; сделай ролик, который хвалят</span>
        <span class="ai-cursor">▍</span>
      </div>
    </div>
  )}

  {figure === 'doc' && (
    <div class="hfig hfig-doc">
      <div class="clap-box">
        <span class="clap-top"></span>
        <span class="clap-hinge"></span>
        <div class="clap-slate">
          <span>СЦЕНА<br><strong>04</strong></span>
          <span>ДУБЛЬ<br><strong>01</strong></span>
          <span class="clap-dir">РЕЖ. ХВАЛИТЕ MEDIA</span>
        </div>
      </div>
      <span class="clap-pop">ХЛОП!</span>
    </div>
  )}

  {figure === 'cube' && (
    <div class="hfig hfig-cube">
      <span class="cube-floor"></span>
      <span class="cube-shadow"></span>
      <div class="cube-scene">
        <div class="cube-rot-y">
          <div class="cube-rot-tumble">
            <div class="cube-side cf-front">
              <svg width="44" height="44" viewBox="0 0 200 200"><polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="8" stroke-linejoin="round"></polygon></svg>
            </div>
            <div class="cube-side cf-right"></div>
            <div class="cube-side cf-back"></div>
            <div class="cube-side cf-left"></div>
            <div class="cube-side cf-top"></div>
            <div class="cube-side cf-bottom"></div>
          </div>
        </div>
      </div>
    </div>
  )}

  {figure === 'switcher' && (
    <div class="hfig hfig-switcher">
      <div class="switcher-screens">
        <div class="sw-cam c1 active-cam">
          <span class="sw-lbl">CAM 1</span>
          <span class="sw-pgm">PGM</span>
        </div>
        <div class="sw-cam c2">
          <svg width="40%" height="40%" viewBox="0 0 200 200" class="cam-star"><polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#B9C6FB" stroke="#B9C6FB" stroke-width="8" stroke-linejoin="round"></polygon></svg>
          <span class="sw-lbl">CAM 2</span>
          <span class="sw-pgm">PGM</span>
        </div>
        <div class="sw-cam c3">
          <span class="sw-lbl">CAM 3</span>
          <span class="sw-pgm">PGM</span>
        </div>
        <div class="sw-cam c4">
          <span class="sw-lbl">CAM 4</span>
          <span class="sw-pgm">PGM</span>
        </div>
        <div class="sw-vu-meter">
          <span>L</span><span class="vu-bar vu-1"></span>
        </div>
        <div class="sw-vu-meter">
          <span>R</span><span class="vu-bar vu-2"></span>
        </div>
      </div>
      <div class="switcher-chyron">
        <div class="chyron-track">
          <span>В ЭФИРЕ ★ МНОГОКАМЕРНЫЕ ТРАНСЛЯЦИИ ★ РЕЖИССЁР ЭФИРА ★ ЗВУК ★ ГРАФИКА ★ ЗАПИСЬ ★&nbsp;</span>
          <span>В ЭФИРЕ ★ МНОГОКАМЕРНЫЕ ТРАНСЛЯЦИИ ★ РЕЖИССЁР ЭФИРА ★ ЗВУК ★ ГРАФИКА ★ ЗАПИСЬ ★&nbsp;</span>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .hero-visual {
    position: relative;
    width: 100%;
    min-height: 320px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2px solid #2A2A2A;
    box-shadow: 10px 10px 0 #10142E;
  }

  .hfig {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── 01 REC ── */
  .hfig-rec {
    background-color: #141414;
    background-image:
      linear-gradient(90deg, transparent calc(33.33% - 1px), rgba(228,227,222,0.1) calc(33.33% - 1px) 33.33%, transparent 33.33% calc(66.66% - 1px), rgba(228,227,222,0.1) calc(66.66% - 1px) 66.66%, transparent 66.66%),
      linear-gradient(transparent calc(33.33% - 1px), rgba(228,227,222,0.1) calc(33.33% - 1px) 33.33%, transparent 33.33% calc(66.66% - 1px), rgba(228,227,222,0.1) calc(66.66% - 1px) 66.66%, transparent 66.66%);
  }
  .hfig-rec .sun {
    position: absolute;
    right: 18%;
    bottom: 34%;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #D4A54C;
    display: block;
    box-shadow: 0 0 24px rgba(212, 165, 76, 0.4);
    animation: sunBob 6s ease-in-out infinite alternate;
  }
  @keyframes sunBob {
    from { transform: translateY(0); }
    to { transform: translateY(-16px); }
  }
  .hfig-rec .sky {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 160%;
    height: 48%;
    display: block;
    animation: skyScroll 24s linear infinite;
  }
  @keyframes skyScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-30%); }
  }
  .vc {
    position: absolute;
    width: 28px;
    height: 28px;
    pointer-events: none;
  }
  .vc-tl { left: 20px; top: 20px; border-left: 3px solid #D4A54C; border-top: 3px solid #D4A54C; }
  .vc-tr { right: 20px; top: 20px; border-right: 3px solid #D4A54C; border-top: 3px solid #D4A54C; }
  .vc-bl { left: 20px; bottom: 20px; border-left: 3px solid #D4A54C; border-bottom: 3px solid #D4A54C; }
  .vc-br { right: 20px; bottom: 20px; border-right: 3px solid #D4A54C; border-bottom: 3px solid #D4A54C; }
  .center-cross {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    opacity: 0.8;
    background:
      linear-gradient(#E4E3DE, #E4E3DE) center / 2px 100% no-repeat,
      linear-gradient(#E4E3DE, #E4E3DE) center / 100% 2px no-repeat;
  }
  .iso-info {
    position: absolute;
    right: 58px;
    top: 24px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #E4E3DE;
  }
  .tc-info {
    position: absolute;
    left: 58px;
    bottom: 24px;
    display: flex;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #E4E3DE;
  }
  .tc-roll-wrap {
    display: block;
    height: 1.2em;
    overflow: hidden;
  }
  .tcroll {
    display: block;
    animation: tc 1s steps(25) infinite;
  }
  .battery-ind {
    position: absolute;
    right: 58px;
    bottom: 24px;
    display: flex;
    gap: 3px;
    padding: 2px;
    border: 1.5px solid #E4E3DE;
  }
  .battery-ind span {
    display: block;
    width: 6px;
    height: 9px;
    background: #E4E3DE;
  }
  .battery-ind .bat-empty {
    background: #5E5D58;
  }
  .rec-badge {
    position: absolute;
    left: 58px;
    top: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: #D4A54C;
  }
  .rec-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #D4A54C;
    animation: blink 1s infinite alternate;
  }
  @keyframes blink {
    from { opacity: 1; }
    to { opacity: 0.2; }
  }

  /* ── 02 AD ── */
  .hfig-ad {
    background: #D4A54C;
    color: #1B1B1B;
  }
  .ad-rays {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 600px;
    height: 600px;
    margin: -300px 0 0 -300px;
    border-radius: 50%;
    background: repeating-conic-gradient(rgba(27,27,27,0.12) 0deg 9deg, transparent 9deg 18deg);
    animation: spin 30s linear infinite;
  }
  .ad-dots {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image: radial-gradient(#1B1B1B 1.3px, transparent 1.7px);
    background-size: 10px 10px;
  }
  .ad-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220px;
    height: 220px;
    margin: -110px 0 0 -110px;
    overflow: visible;
    animation: spin 18s linear infinite reverse;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 13px;
  }
  .ad-center-star {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    animation: pulseStar 4s ease-in-out infinite alternate;
  }
  @keyframes pulseStar {
    0% { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.08) rotate(45deg); }
  }
  .ad-live-badge {
    position: absolute;
    right: 20px;
    top: 20px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.1em;
    padding: 6px 12px;
    background: #1B1B1B;
    color: #D4A54C;
  }

  /* ── 03 AI ── */
  .hfig-ai {
    background: #10142E;
    flex-direction: column;
    gap: 20px;
    padding: 30px;
    background-image: radial-gradient(rgba(185,198,251,0.16) 1px, transparent 1.3px);
    background-size: 14px 14px;
  }
  .ai-pixel-grid {
    display: grid;
    grid-template-columns: repeat(13, 13px);
    gap: 3px;
    justify-content: center;
  }
  .ai-prompt-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(16, 20, 46, 0.85);
    border: 1px solid #B9C6FB;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    color: #B9C6FB;
    letter-spacing: 0.05em;
  }
  .ai-cursor {
    animation: blink 0.8s infinite;
  }

  /* ── 04 DOC ── */
  .hfig-doc {
    background: #F1F0EC;
    color: #1B1B1B;
    background-image: repeating-linear-gradient(transparent 0 21px, rgba(27,27,27,0.08) 21px 22px);
  }
  .clap-box {
    position: relative;
    width: 220px;
    height: 154px;
    animation: clapshake 4s infinite;
  }
  .clap-top {
    position: absolute;
    left: 0;
    top: 0;
    width: 220px;
    height: 28px;
    box-sizing: border-box;
    border: 2px solid #1B1B1B;
    background: repeating-linear-gradient(120deg, #1B1B1B 0 14px, #FFFFFF 14px 28px);
    transform-origin: 0 100%;
    animation: clapMotion 3.5s ease-in-out infinite;
  }
  @keyframes clapMotion {
    0%, 75%, 100% { transform: rotate(0deg); }
    80%, 95% { transform: rotate(-22deg); }
  }
  .clap-hinge {
    position: absolute;
    left: 0;
    top: 30px;
    width: 220px;
    height: 22px;
    border: 2px solid #1B1B1B;
    background: repeating-linear-gradient(60deg, #1B1B1B 0 14px, #FFFFFF 14px 28px);
    box-sizing: border-box;
  }
  .clap-slate {
    position: absolute;
    left: 0;
    top: 54px;
    width: 220px;
    height: 98px;
    padding: 12px 14px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 12px;
    background: #1B1B1B;
    color: #E4E3DE;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .clap-slate strong {
    display: block;
    font-family: 'Unbounded', 'Arial Black', sans-serif;
    font-weight: 900;
    font-size: 20px;
    color: #FFFFFF;
  }
  .clap-dir {
    grid-column: span 2;
    padding-top: 8px;
    border-top: 1px solid #5E5D58;
    color: #A8A7A2;
    font-size: 10px;
  }
  .clap-pop {
    position: absolute;
    right: 28px;
    top: 24px;
    padding: 6px 12px;
    background: #3358F4;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.08em;
    transform: rotate(10deg);
    animation: popBounce 1.5s ease-in-out infinite alternate;
  }
  @keyframes popBounce {
    0% { transform: rotate(8deg) scale(0.95); }
    100% { transform: rotate(14deg) scale(1.08); }
  }

  /* ── 05 CUBE ── */
  .hfig-cube {
    background: #3358F4;
    perspective: 700px;
  }
  .cube-floor {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: -10px;
    height: 180px;
    background-image:
      linear-gradient(rgba(255,255,255,0.45) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.45) 1px, transparent 1px);
    background-size: 28px 28px;
    transform: perspective(260px) rotateX(68deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, #000 35%, transparent);
    animation: floor 0.8s linear infinite;
  }
  .cube-shadow {
    position: absolute;
    left: 50%;
    top: 76%;
    width: 110px;
    height: 16px;
    margin-left: -55px;
    border-radius: 50%;
    background: rgba(16, 20, 46, 0.5);
  }
  .cube-scene {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }
  .cube-rot-y {
    position: absolute;
    left: -44px;
    top: -44px;
    width: 88px;
    height: 88px;
    transform-style: preserve-3d;
    animation: cube 18s linear infinite;
  }
  .cube-rot-tumble {
    position: absolute;
    width: 88px;
    height: 88px;
    transform-style: preserve-3d;
    animation: tumble 4s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  .cube-side {
    position: absolute;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #FFFFFF;
    background: rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
  }
  .cf-front  { transform: rotateY(0deg) translateZ(44px); }
  .cf-right  { transform: rotateY(90deg) translateZ(44px); }
  .cf-back   { transform: rotateY(180deg) translateZ(44px); }
  .cf-left   { transform: rotateY(-90deg) translateZ(44px); }
  .cf-top    { transform: rotateX(90deg) translateZ(44px); }
  .cf-bottom { transform: rotateX(-90deg) translateZ(44px); }

  /* ── 06 SWITCHER ── */
  .hfig-switcher {
    background: #2A2A2A;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 42px;
  }
  .switcher-screens {
    width: 90%;
    max-width: 460px;
    margin: auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .sw-cam {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 3px solid #5E5D58;
    background: #141414;
    animation: tally 6s steps(1, end) infinite;
  }
  .sw-cam.c1 {
    background: linear-gradient(90deg, #E4E3DE 0 14.28%, #D4A54C 0 28.56%, #B9C6FB 0 42.84%, #3358F4 0 57.12%, #10142E 0 71.4%, #5E5D58 0 85.68%, #1B1B1B 0);
  }
  .sw-cam.c2 {
    background: #10142E;
    animation-delay: -4.5s;
  }
  .sw-cam.c3 {
    background-color: #3358F4;
    background-image: radial-gradient(rgba(255,255,255,0.6) 1.4px, transparent 1.8px);
    background-size: 8px 8px;
    animation-delay: -3s;
  }
  .sw-cam.c4 {
    background-color: #1B1B1B;
    background-image: repeating-radial-gradient(circle at 50% 50%, #D4A54C 0 2px, transparent 2px 9px);
    animation-delay: -1.5s;
  }
  .cam-star {
    position: absolute;
    left: 30%;
    top: 30%;
  }
  .sw-lbl {
    position: absolute;
    left: 4px;
    top: 4px;
    padding: 2px 4px;
    background: #1B1B1B;
    color: #E4E3DE;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  .sw-pgm {
    position: absolute;
    right: 4px;
    bottom: 4px;
    padding: 2px 4px;
    background: #D4A54C;
    color: #1B1B1B;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.08em;
    animation: pgm 6s steps(1, end) infinite;
  }
  .c2 .sw-pgm { animation-delay: -4.5s; }
  .c3 .sw-pgm { animation-delay: -3s; }
  .c4 .sw-pgm { animation-delay: -1.5s; }
  .sw-vu-meter {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 10px;
    color: #E4E3DE;
  }
