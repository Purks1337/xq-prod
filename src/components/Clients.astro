---
// Clients.astro
import { getAssetUrl } from '../utils/paths';

interface Client {
  name: string;
  img: string;
  width: number;
  height: number;
  hasCase?: boolean;
}

const SCALE = 0.32;

const clientsList: Client[] = [
  { name: 'КАМАЗ', img: getAssetUrl('/assets/img/logos/kamaz.svg'), width: 130, height: 180 },
  { name: 'MEDLIGA', img: getAssetUrl('/assets/img/logos/medliga.svg'), width: 637, height: 154, hasCase: true },
  { name: 'Газпром', img: getAssetUrl('/assets/img/logos/gazprom.svg'), width: 296, height: 238 },
  { name: 'Пятёрочка', img: getAssetUrl('/assets/img/logos/pyaterochka.svg'), width: 238, height: 217 },
  { name: 'Фестиваль «Пляж»', img: getAssetUrl('/assets/img/logos/plyazh.svg'), width: 428, height: 208 },
  { name: 'КХЛ', img: getAssetUrl('/assets/img/logos/khl.svg'), width: 235, height: 224 },
  { name: 'СИБУР', img: getAssetUrl('/assets/img/logos/sibur.svg'), width: 413, height: 78 },
  { name: 'Свердловская киностудия', img: getAssetUrl('/assets/img/logos/kinostudia.svg'), width: 667, height: 188 },
  { name: 'Сбер', img: getAssetUrl('/assets/img/logos/sber.svg'), width: 455, height: 98 },
  { name: 'LADA', img: getAssetUrl('/assets/img/logos/lada.svg'), width: 159, height: 112 },
  { name: 'ESOX', img: getAssetUrl('/assets/img/logos/esox.svg'), width: 330, height: 78 },
  { name: 'Брусника', img: getAssetUrl('/assets/img/logos/brusnika.svg'), width: 502, height: 162 },
  { name: 'Atlas Development', img: getAssetUrl('/assets/img/logos/atlas.svg'), width: 340, height: 114 },
  { name: 'VETLIGA', img: getAssetUrl('/assets/img/logos/vetliga.svg'), width: 1000, height: 123, hasCase: true },
  { name: 'Т-Банк', img: getAssetUrl('/assets/img/logos/tbank.svg'), width: 283, height: 108 },
  { name: 'РЖД', img: getAssetUrl('/assets/img/logos/rjd.svg'), width: 492, height: 184 },
  { name: 'Синара', img: getAssetUrl('/assets/img/logos/sinara.svg'), width: 702, height: 134 },
  { name: 'Ростелеком', img: getAssetUrl('/assets/img/logos/rostelekom.svg'), width: 491, height: 146 },
  { name: 'Changan', img: getAssetUrl('/assets/img/logos/changan.svg'), width: 356, height: 92 },
  { name: 'МХЛ', img: getAssetUrl('/assets/img/logos/jhl.svg'), width: 207, height: 238 },
  { name: 'Netflix', img: getAssetUrl('/assets/img/logos/netflix.svg'), width: 270, height: 184 }
];
---

<section id="klienty" style="background: #E4E3DE; color: #1B1B1B; padding: 88px 0 80px">
  <div style="max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px; margin-bottom: 36px">
    <div style="display: flex; flex-direction: column; gap: 14px">
      <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.12em; color: #5E5D58">04 · КЛИЕНТЫ</span>
      <h2 style="margin: 0; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 900; font-size: clamp(36px, 5vw, 68px); line-height: 1">С КЕМ РАБОТАЛИ</h2>
    </div>
    <p style="margin: 0; max-width: 420px; font-size: 17px; line-height: 1.5">Где есть кейс — жмите и смотрите. Где NDA — работа под соглашением о неразглашении. Наведите курсор на самый край ленты — она поедет быстрее.</p>
  </div>

  <div class="mq" data-on-mousemove="mqMove" data-on-mouseleave="mqLeave" style="overflow: hidden; padding: 10px 0 18px">
    <div class="mq-ltr" data-ref="setTrack" style="display: flex; width: max-content; gap: 20px; padding-left: 20px">
      <!-- Первый круг логотипов -->
      {clientsList.map((client) => {
        const w = Math.round(client.width * SCALE);
        const h = Math.round(client.height * SCALE);
        return (
          <div aria-hidden="false" style="position: relative; flex: 0 0 auto; height: 124px; min-width: 220px; box-sizing: border-box; padding: 18px 32px; display: flex; align-items: center; justify-content: center; background: #FFFFFF; border: 2px solid #1B1B1B; box-shadow: 6px 6px 0 #1B1B1B">
            {client.img ? (
              <img
                src={client.img}
                alt={client.name}
                width={w}
                height={h}
                loading="lazy"
                decoding="async"
                style={`display: block; width: ${w}px; height: ${h}px; max-height: 80px; max-width: none; object-fit: contain;`}
              />
            ) : (
              <span style="display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center">
                <span style="font-weight: 800; font-size: 20px; line-height: 1.1; letter-spacing: -0.01em">{client.name}</span>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; color: #5E5D58">ЖДЁТ ФАЙЛ ЛОГОТИПА</span>
              </span>
            )}

            {client.hasCase ? (
              <a href="#kejsy" tabindex="0" style="position: absolute; right: -2px; top: -2px; padding: 5px 9px; background: #3358F4; color: #FFFFFF; text-decoration: none; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11px; letter-spacing: 0.08em">КЕЙС ↗</a>
            ) : (
              <span style="position: absolute; right: 10px; top: 10px; padding: 2px 8px; border: 2px solid #1B1B1B; transform: rotate(-8deg); font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.12em">NDA</span>
            )}
          </div>
        );
      })}

      <!-- Второй круг логотипов (для бесконечной анимации) -->
      {clientsList.map((client) => {
        const w = Math.round(client.width * SCALE);
        const h = Math.round(client.height * SCALE);
        return (
          <div aria-hidden="true" style="position: relative; flex: 0 0 auto; height: 124px; min-width: 220px; box-sizing: border-box; padding: 18px 32px; display: flex; align-items: center; justify-content: center; background: #FFFFFF; border: 2px solid #1B1B1B; box-shadow: 6px 6px 0 #1B1B1B">
            {client.img ? (
              <img
                src={client.img}
                alt={client.name}
                width={w}
                height={h}
                loading="lazy"
                decoding="async"
                style={`display: block; width: ${w}px; height: ${h}px; max-height: 80px; max-width: none; object-fit: contain;`}
              />
            ) : (
              <span style="display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center">
                <span style="font-weight: 800; font-size: 20px; line-height: 1.1; letter-spacing: -0.01em">{client.name}</span>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; color: #5E5D58">ЖДЁТ ФАЙЛ ЛОГОТИПА</span>
              </span>
            )}

            {client.hasCase ? (
              <a href="#kejsy" tabindex="-1" style="position: absolute; right: -2px; top: -2px; padding: 5px 9px; background: #3358F4; color: #FFFFFF; text-decoration: none; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11px; letter-spacing: 0.08em">КЕЙС ↗</a>
            ) : (
              <span style="position: absolute; right: 10px; top: 10px; padding: 2px 8px; border: 2px solid #1B1B1B; transform: rotate(-8deg); font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.12em">NDA</span>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
