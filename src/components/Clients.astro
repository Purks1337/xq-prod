---
// Clients.astro
import { getAssetUrl } from '../utils/paths';

interface Client {
  name: string;
  img: string;
  width: number;
  height: number;
  hasCase?: boolean;
}

const SCALE_MOBILE = 0.32;
const SCALE_DESKTOP = 0.48;

const clientsList: Client[] = [
  { name: 'КАМАЗ', img: getAssetUrl('/assets/img/logos/kamaz.svg'), width: 130, height: 180 },
  { name: 'MEDLIGA', img: getAssetUrl('/assets/img/logos/medliga.svg'), width: 637, height: 154, hasCase: true },
  { name: 'Газпром', img: getAssetUrl('/assets/img/logos/gazprom.svg'), width: 296, height: 238 },
  { name: 'Пятёрочка', img: getAssetUrl('/assets/img/logos/pyaterochka.svg'), width: 238, height: 217 },
  { name: 'Фестиваль «Пляж»', img: getAssetUrl('/assets/img/logos/plyazh.svg'), width: 428, height: 208 },
  { name: 'КХЛ', img: getAssetUrl('/assets/img/logos/khl.svg'), width: 235, height: 224 },
  { name: 'СИБУР', img: getAssetUrl('/assets/img/logos/sibur.svg'), width: 413, height: 78 },
  { name: 'Свердловская киностудия', img: getAssetUrl('/assets/img/logos/kinostudia.svg'), width: 667, height: 188 },
  { name: 'Сбер', img: getAssetUrl('/assets/img/logos/sber.svg'), width: 455, height: 98 },
  { name: 'LADA', img: getAssetUrl('/assets/img/logos/lada.svg'), width: 159, height: 112 },
  { name: 'ESOX', img: getAssetUrl('/assets/img/logos/esox.svg'), width: 330, height: 78 },
  { name: 'Брусника', img: getAssetUrl('/assets/img/logos/brusnika.svg'), width: 502, height: 162 },
  { name: 'Atlas Development', img: getAssetUrl('/assets/img/logos/atlas.svg'), width: 340, height: 114 },
  { name: 'VETLIGA', img: getAssetUrl('/assets/img/logos/vetliga.svg'), width: 1000, height: 123, hasCase: true },
  { name: 'Т-Банк', img: getAssetUrl('/assets/img/logos/tbank.svg'), width: 283, height: 108 },
  { name: 'РЖД', img: getAssetUrl('/assets/img/logos/rjd.svg'), width: 492, height: 184 },
  { name: 'Синара', img: getAssetUrl('/assets/img/logos/sinara.svg'), width: 702, height: 134 },
  { name: 'Ростелеком', img: getAssetUrl('/assets/img/logos/rostelekom.svg'), width: 491, height: 146 },
  { name: 'Changan', img: getAssetUrl('/assets/img/logos/changan.svg'), width: 356, height: 92 },
  { name: 'МХЛ', img: getAssetUrl('/assets/img/logos/jhl.svg'), width: 207, height: 238 },
  { name: 'Netflix', img: getAssetUrl('/assets/img/logos/netflix.svg'), width: 270, height: 184 },
  { name: '100+ TechnoBuild', img: getAssetUrl('/assets/img/logos/100plus.svg'), width: 502, height: 106 },
  { name: 'FIDE', img: getAssetUrl('/assets/img/logos/fide.svg'), width: 274, height: 192 },
  { name: 'Speedsoft', img: getAssetUrl('/assets/img/logos/speedsoft.svg'), width: 400, height: 132 },
  { name: 'Ural Motorsport', img: getAssetUrl('/assets/img/logos/uralmotorsport.svg'), width: 358, height: 126 },
  { name: 'Ural Music Night', img: getAssetUrl('/assets/img/logos/uralmusicnight.svg'), width: 227, height: 177 }
];
---

<section id="klienty" style="background: #E4E3DE; color: #1B1B1B; padding: 88px 0 80px">
  <div class="clients-head" style="max-width: 1080px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px; margin-bottom: 36px">
    <div style="display: flex; flex-direction: column; gap: 14px">
      <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.12em; color: #5E5D58">04 · КЛИЕНТЫ</span>
      <h2 style="margin: 0; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 900; font-size: clamp(36px, 5vw, 68px); line-height: 1">С КЕМ РАБОТАЛИ</h2>
    </div>
    <p style="margin: 0; max-width: 420px; font-size: 17px; line-height: 1.5">Компании и бренды, с которыми мы работаем. Наведите курсор на самый край ленты — она поедет быстрее.</p>
  </div>

  <div class="mq clients-mq" data-on-mousemove="mqMove" data-on-mouseleave="mqLeave">
    <div class="mq-ltr clients-track" data-ref="setTrack">
      <!-- Первый круг логотипов -->
      {clientsList.map((client) => {
        const wMob = Math.round(client.width * SCALE_MOBILE);
        const hMob = Math.round(client.height * SCALE_MOBILE);
        const wDesk = Math.round(client.width * SCALE_DESKTOP);
        const hDesk = Math.round(client.height * SCALE_DESKTOP);
        return (
          <div
            aria-hidden="false"
            class="client-item"
            style={`--w-mob: ${wMob}px; --h-mob: ${hMob}px; --w-desk: ${wDesk}px; --h-desk: ${hDesk}px;`}
          >
            {client.img ? (
              <img
                src={client.img}
                alt={client.name}
                width={wDesk}
                height={hDesk}
                loading="lazy"
                decoding="async"
                class="client-logo-img"
              />
            ) : (
              <span class="client-fallback">
                <span class="client-fallback-name">{client.name}</span>
                <span class="client-fallback-sub">ЖДЁТ ФАЙЛ ЛОГОТИПА</span>
              </span>
            )}
          </div>
        );
      })}

      <!-- Второй круг логотипов (для бесконечной анимации) -->
      {clientsList.map((client) => {
        const wMob = Math.round(client.width * SCALE_MOBILE);
        const hMob = Math.round(client.height * SCALE_MOBILE);
        const wDesk = Math.round(client.width * SCALE_DESKTOP);
        const hDesk = Math.round(client.height * SCALE_DESKTOP);
        return (
          <div
            aria-hidden="true"
            class="client-item"
            style={`--w-mob: ${wMob}px; --h-mob: ${hMob}px; --w-desk: ${wDesk}px; --h-desk: ${hDesk}px;`}
          >
            {client.img ? (
              <img
                src={client.img}
                alt={client.name}
                width={wDesk}
                height={hDesk}
                loading="lazy"
                decoding="async"
                class="client-logo-img"
              />
            ) : (
              <span class="client-fallback">
                <span class="client-fallback-name">{client.name}</span>
                <span class="client-fallback-sub">ЖДЁТ ФАЙЛ ЛОГОТИПА</span>
              </span>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .clients-mq {
    overflow: hidden;
    padding: 10px 0 18px;
  }

  .clients-track {
    display: flex;
    width: max-content;
    gap: 16px;
    padding-left: 16px;
    align-items: center;
  }

  .client-item {
    position: relative;
    flex: 0 0 auto;
    height: 80px;
    min-width: 120px;
    box-sizing: border-box;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .client-logo-img {
    display: block;
    width: var(--w-mob);
    height: var(--h-mob);
    max-height: 60px;
    max-width: none;
    object-fit: contain;
  }

  .client-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .client-fallback-name {
    font-weight: 800;
    font-size: 18px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .client-fallback-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #5E5D58;
  }

  /* ПК версия: увеличенный контейнер и логотипы с аккуратным расстоянием */
  @media (min-width: 768px) {
    .clients-head {
      margin-bottom: 40px !important;
    }

    .clients-mq {
      padding: 20px 0 28px;
    }

    .clients-track {
      gap: 24px;
      padding-left: 20px;
    }

    .client-item {
      height: 124px;
      min-width: 160px;
      padding: 16px 20px;
    }

    .client-logo-img {
      width: var(--w-desk);
      height: var(--h-desk);
      max-height: 84px;
    }

    .client-fallback-name {
      font-size: 22px;
    }
  }

  @media (min-width: 1200px) {
    .clients-track {
      gap: 28px;
    }

    .client-item {
      height: 130px;
      min-width: 170px;
      padding: 16px 24px;
    }

    .client-logo-img {
      max-height: 88px;
    }
  }
</style>
