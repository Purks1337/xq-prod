---
// LeadForm.astro
import { getAssetUrl } from '../utils/paths';
---

<section id="zayavka" style="background: #3358F4; color: #FFFFFF; padding: 96px 0">
  <div style="max-width: 1080px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: start">
    <div style="display: flex; flex-direction: column; gap: 22px; min-width: 0">
      <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.12em">06 · ЗАЯВКА</span>
      <h2 style="margin: 0; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 900; font-size: clamp(34px, 4.6vw, 62px); line-height: 1.02; display: flex; flex-direction: column">
        <span>ОБСУДИМ</span>
        <span>ПРОЕКТ?</span>
      </h2>
      <p style="margin: 0; max-width: 480px; font-size: 18px; line-height: 1.5">
        Расскажите задачу — продюсер перезвонит, задаст пару вопросов и соберёт смету проекта.
      </p>
      <a href="tel:+79022775570" style="color: #FFFFFF; text-decoration: none; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 800; font-size: clamp(22px, 2.4vw, 30px)">+7 902 277 55 70</a>
      <div style="display: flex; flex-wrap: wrap; gap: 10px">
        <a href="https://t.me/hvalitemedia" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border: 2px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 15px">Telegram</a>
        <a href="https://wa.me/message/FTUPFBI5PTVXM1" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border: 2px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 15px">WhatsApp</a>
        <a href="https://vk.ru/hvalitemedia" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border: 2px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 15px">ВКонтакте</a>
        <a href="https://www.instagram.com/hvalite_media" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border: 2px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 15px">Instagram</a>
        <a href="https://max.ru/u/f9LHodD0cOJlKJD7_H4cAo2_YvP5zo4I4avnmkRYVL4s5P1zzELtY8c8xPA" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border: 2px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 15px">MAX</a>
        <a href="mailto:hvalitemedia@gmail.com" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 20px; border: 2px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 800; font-size: 15px">hvalitemedia@gmail.com</a>
      </div>
    </div>

    <form aria-label="Заявка на проект" style="display: flex; flex-direction: column; gap: 16px; padding: 28px; background: #FFFFFF; color: #1B1B1B; border: 3px solid #10142E; box-shadow: 12px 12px 0 #10142E; min-width: 0">
      <span data-if="notSent" style="display: contents">
        <label style="display: flex; flex-direction: column; gap: 6px">
          <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em">ИМЯ ИЛИ КОМПАНИЯ</span>
          <input type="text" name="name" autocomplete="organization" style="height: 48px; padding: 0 14px; border: 2px solid #1B1B1B; font-family: inherit; font-size: 16px" />
        </label>
        <label style="display: flex; flex-direction: column; gap: 6px">
          <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em">ТЕЛЕФОН ИЛИ TELEGRAM</span>
          <input type="text" name="contact" required autocomplete="tel" style="height: 48px; padding: 0 14px; border: 2px solid #1B1B1B; font-family: inherit; font-size: 16px" />
        </label>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px">
          <label style="display: flex; flex-direction: column; gap: 6px">
            <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em">ЧТО СНИМАЕМ</span>
            <select name="service" style="height: 48px; padding: 0 10px; border: 2px solid #1B1B1B; background: #FFFFFF; font-family: inherit; font-size: 16px">
              <option>Имиджевый ролик</option>
              <option>Реклама</option>
              <option>AI-видео</option>
              <option>Документальный фильм</option>
              <option>3D-ролик</option>
              <option>Онлайн-трансляция</option>
              <option>Пока не знаю</option>
            </select>
          </label>
          <label style="display: flex; flex-direction: column; gap: 6px">
            <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em">БЮДЖЕТ</span>
            <select name="budget" style="height: 48px; padding: 0 10px; border: 2px solid #1B1B1B; background: #FFFFFF; font-family: inherit; font-size: 16px">
              <option>Пока не знаю</option>
              <option>до 150 000 ₽</option>
              <option>150–300 000 ₽</option>
              <option>300–600 000 ₽</option>
              <option>больше 600 000 ₽</option>
            </select>
          </label>
        </div>
        <label style="display: flex; flex-direction: column; gap: 6px">
          <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em">О ЗАДАЧЕ</span>
          <textarea name="about" rows="4" style="padding: 12px 14px; border: 2px solid #1B1B1B; font-family: inherit; font-size: 16px; resize: vertical"></textarea>
        </label>
        <label style="display: flex; align-items: flex-start; gap: 10px; font-size: 13px; line-height: 1.45; color: #3A3A3A; cursor: pointer">
          <input type="checkbox" name="agree" required checked style="width: 20px; height: 20px; margin: 0; flex: 0 0 auto; cursor: pointer" />
          <span>Согласен на <a href={getAssetUrl('/privacy/#consent')} target="_blank" rel="noopener noreferrer" style="color: #1B1B1B; text-decoration: underline">обработку персональных данных</a> и с <a href={getAssetUrl('/privacy/')} target="_blank" rel="noopener noreferrer" style="color: #1B1B1B; text-decoration: underline">политикой конфиденциальности</a></span>
        </label>
        <button type="button" data-on-click="send" style="min-height: 56px; border: 0; background: #1B1B1B; color: #FFFFFF; font-family: inherit; font-weight: 800; font-size: 17px; cursor: pointer">
          Отправить заявку
        </button>
      </span>
      <span data-if="sent" style="display: none">
        <div style="display: flex; flex-direction: column; gap: 12px; padding: 24px 0">
          <span style="font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 900; font-size: 28px">ГОТОВО!</span>
          <p style="margin: 0; font-size: 17px; line-height: 1.5">Заявка у продюсера. Свяжемся с вами и пришлём смету.</p>
        </div>
      </span>
    </form>
  </div>
</section>
