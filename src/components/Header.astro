---
// Header.astro
import { getAssetUrl } from '../utils/paths';

const pathname = Astro.url.pathname;
const isCatalogPage = pathname.endsWith('/uslugi/') || pathname.endsWith('/uslugi');
const isServicePage = pathname.includes('/uslugi/') && !isCatalogPage;

const casesHref = isCatalogPage ? getAssetUrl('/#kejsy') : '#kejsy';
const processHref = isServicePage ? '#etapy' : (isCatalogPage ? getAssetUrl('/#process') : '#process');
const clientsHref = isCatalogPage ? getAssetUrl('/#klienty') : '#klienty';
const teamHref = isCatalogPage ? getAssetUrl('/#komanda') : '#komanda';

const servicesNav = [
  { num: '01', title: 'Имиджевый ролик', url: getAssetUrl('/uslugi/imidzhevyj-rolik/') },
  { num: '02', title: 'Рекламный ролик', url: getAssetUrl('/uslugi/reklamnyj-rolik/') },
  { num: '03', title: 'AI-видео', url: getAssetUrl('/uslugi/ai-video/') },
  { num: '04', title: 'Документальный фильм', url: getAssetUrl('/uslugi/dokumentalnyj-film/') },
  { num: '05', title: '3D-ролики', url: getAssetUrl('/uslugi/3d-rolik/') },
  { num: '06', title: 'Онлайн-трансляции', url: getAssetUrl('/uslugi/onlajn-translyaciya/') }
];
---

<header class="hdr">
  <div class="hdr-inner">
    <a href={getAssetUrl('/')} aria-label="Хвалите Media — на главную" class="hdr-logo">
      <span class="hdr-brand">
        <svg aria-hidden="true" width="0.82em" height="0.82em" viewBox="0 0 200 200" class="hdr-star">
          <polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#3358F4" stroke="#3358F4" stroke-width="8" stroke-linejoin="round"></polygon>
        </svg>
        <span>ХВАЛИТЕ</span>
      </span>
      <span class="hdr-badge">MEDIA</span>
    </a>

    <!-- Desktop nav + contacts (hidden on mobile) -->
    <nav aria-label="Разделы сайта" class="hdr-nav">
      <div class="hdr-dd-wrap">
        <a href={getAssetUrl('/uslugi/')} class="hdr-link hdr-dd-trigger">
          Услуги
          <svg class="hdr-chevron" width="9" height="6" viewBox="0 0 9 6" fill="none"><path d="M1 1.2L4.5 4.8L8 1.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        </a>
        <div class="hdr-dd-menu" role="menu">
          {servicesNav.map(s => (
            <a href={s.url} class="hdr-dd-item" role="menuitem">
              <span class="hdr-dd-num">{s.num}</span>
              <span class="hdr-dd-title">{s.title}</span>
            </a>
          ))}
          <a href={getAssetUrl('/uslugi/')} class="hdr-dd-all">Все услуги каталога →</a>
        </div>
      </div>
      <a href={casesHref} class="hdr-link">Кейсы</a>
      {isServicePage ? (
        <a href="#ceny" class="hdr-link">Цены</a>
      ) : null}
      <a href={processHref} class="hdr-link">Как работаем</a>
      <a href={clientsHref} class="hdr-link">Клиенты</a>
      <a href={teamHref} class="hdr-link">Команда</a>
      {isServicePage ? (
        <a href="#faq" class="hdr-link">FAQ</a>
      ) : null}
    </nav>
    <a href="tel:+79923410520" class="hdr-phone">+7 992 341-05-20</a>
    <a href="#zayavka" class="hdr-cta">Обсудить проект</a>

    <!-- Burger button (visible only on mobile) -->
    <button class="hdr-burger" aria-label="Меню" aria-expanded="false" type="button">
      <span class="hdr-burger-line"></span>
      <span class="hdr-burger-line"></span>
      <span class="hdr-burger-line"></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="hdr-drawer" aria-hidden="true">
    <nav aria-label="Разделы сайта" class="hdr-drawer-nav">
      <div class="hdr-drawer-services">
        <div class="hdr-drawer-services-title">
          <span>УСЛУГИ</span>
          <a href={getAssetUrl('/uslugi/')} class="hdr-drawer-all-link">Все →</a>
        </div>
        <div class="hdr-drawer-services-grid">
          {servicesNav.map(s => (
            <a href={s.url} class="hdr-drawer-service-item">
              <span class="hdr-drawer-num">{s.num}</span>
              <span class="hdr-drawer-name">{s.title}</span>
            </a>
          ))}
        </div>
      </div>
      <a href={casesHref} class="hdr-drawer-link">Кейсы</a>
      {isServicePage ? (
        <a href="#ceny" class="hdr-drawer-link">Цены</a>
      ) : null}
      <a href={processHref} class="hdr-drawer-link">Как работаем</a>
      <a href={clientsHref} class="hdr-drawer-link">Клиенты</a>
      <a href={teamHref} class="hdr-drawer-link">Команда</a>
      {isServicePage ? (
        <a href="#faq" class="hdr-drawer-link">FAQ</a>
      ) : null}
    </nav>
    <div class="hdr-drawer-actions">
      <a href="tel:+79923410520" class="hdr-drawer-phone">+7 992 341-05-20</a>
      <a href="#zayavka" class="hdr-drawer-cta">Обсудить проект</a>
    </div>
  </div>
</header>

<style>
  /* ─── Base ─── */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #1B1B1B;
    color: #E4E3DE;
    border-bottom: 1px solid #2A2A2A;
  }

  .hdr-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px clamp(16px, 4vw, 48px);
    display: flex;
    align-items: center;
    gap: 14px 28px;
  }

  /* ─── Logo ─── */
  .hdr-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #E4E3DE;
    text-decoration: none;
    flex-shrink: 0;
  }

  .hdr-brand {
    display: flex;
    align-items: baseline;
    font-family: 'Unbounded', 'Arial Black', sans-serif;
    font-weight: 900;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.02em;
    gap: 0.05em;
  }

  .hdr-star {
    display: block;
    flex: 0 0 auto;
    margin-right: 0.22em;
  }

  .hdr-badge {
    padding: 5px 10px 6px;
    border-radius: 999px;
    background: #3358F4;
    color: #FFFFFF;
    font-family: 'Unbounded', 'Arial Black', sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* ─── Desktop nav ─── */
  .hdr-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    flex: 1 1 auto;
    font-size: 15px;
    font-weight: 600;
  }

  .hdr-link {
    color: #E4E3DE;
    text-decoration: none;
    padding: 10px 0;
    transition: color 0.15s;
  }

  .hdr-link:hover {
    color: #3358F4;
  }

  /* ─── Services Dropdown ─── */
  .hdr-dd-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .hdr-dd-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hdr-chevron {
    transition: transform 0.2s;
  }

  .hdr-dd-wrap:hover .hdr-chevron {
    transform: rotate(180deg);
  }

  .hdr-dd-menu {
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    min-width: 250px;
    background: #1B1B1B;
    border: 2px solid #3358F4;
    box-shadow: 6px 6px 0 #10142E;
    padding: 8px;
    display: none;
    flex-direction: column;
    gap: 3px;
    z-index: 110;
  }

  .hdr-dd-wrap:hover .hdr-dd-menu,
  .hdr-dd-wrap:focus-within .hdr-dd-menu {
    display: flex;
  }

  .hdr-dd-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    color: #E4E3DE;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.12s, color 0.12s;
  }

  .hdr-dd-item:hover {
    background: #3358F4;
    color: #FFFFFF;
  }

  .hdr-dd-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: #D4A54C;
  }

  .hdr-dd-item:hover .hdr-dd-num {
    color: #FFFFFF;
  }

  .hdr-dd-all {
    margin-top: 4px;
    padding: 8px 10px 4px;
    border-top: 1px solid #2A2A2A;
    color: #B9C6FB;
    font-size: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    text-decoration: none;
    display: block;
  }

  .hdr-dd-all:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* ─── Drawer Services ─── */
  .hdr-drawer-services {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 8px 0 16px;
    border-bottom: 1px solid #2A2A2A;
  }

  .hdr-drawer-services-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    color: #A8A7A2;
    letter-spacing: 0.1em;
  }

  .hdr-drawer-all-link {
    color: #3358F4;
    text-decoration: none;
    font-size: 12px;
  }

  .hdr-drawer-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 6px;
  }

  .hdr-drawer-service-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: #242424;
    border: 1px solid #333333;
    color: #E4E3DE;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
  }

  .hdr-drawer-service-item:hover {
    background: #3358F4;
    color: #FFFFFF;
  }

  .hdr-drawer-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #D4A54C;
  }

  /* ─── Phone ─── */
  .hdr-phone {
    color: #E4E3DE;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 0;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .hdr-phone:hover {
    color: #3358F4;
  }

  /* ─── CTA ─── */
  .hdr-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    background: #3358F4;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .hdr-cta:hover {
    background: #2848D9;
  }

  /* ─── Burger (hidden by default) ─── */
  .hdr-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  .hdr-burger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: #E4E3DE;
    border-radius: 1px;
    transition: transform 0.25s, opacity 0.25s;
    transform-origin: center;
  }

  /* Burger → cross animation */
  .hdr.open .hdr-burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hdr.open .hdr-burger-line:nth-child(2) {
    opacity: 0;
  }
  .hdr.open .hdr-burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Drawer (mobile only) ─── */
  .hdr-drawer {
    display: none;
    flex-direction: column;
    gap: 0;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), padding 0.35s;
  }

  .hdr-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid #2A2A2A;
    padding-top: 12px;
  }

  .hdr-drawer-link {
    color: #E4E3DE;
    text-decoration: none;
    font-size: 17px;
    font-weight: 600;
    padding: 12px 0;
    transition: color 0.15s;
  }

  .hdr-drawer-link:hover {
    color: #3358F4;
  }

  .hdr-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 0 20px;
    border-top: 1px solid #2A2A2A;
    margin-top: 8px;
  }

  .hdr-drawer-phone {
    color: #E4E3DE;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 16px;
    transition: color 0.15s;
  }

  .hdr-drawer-phone:hover {
    color: #3358F4;
  }

  .hdr-drawer-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    background: #3358F4;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    transition: background 0.15s;
  }

  .hdr-drawer-cta:hover {
    background: #2848D9;
  }

  /* ─── Tablet / Compact desktop: ≤1162px ─── */
  @media (max-width: 1162px) {
    .hdr-inner {
      flex-wrap: wrap;
    }

    /* Logo pushes phone + CTA to the right */
    .hdr-logo {
      margin-right: auto;
    }

    /* Nav drops to second row and spreads across full width */
    .hdr-nav {
      order: 10;
      flex: 0 0 100%;
      display: flex;
      justify-content: space-between;
      border-top: 1px solid #2A2A2A;
      padding-top: 6px;
      padding-bottom: 4px;
      margin-top: 2px;
      gap: 12px;
      font-size: 14px;
    }
  }

  /* ─── Mobile: ≤640px ─── */
  @media (max-width: 640px) {
    .hdr-inner {
      padding: 10px clamp(12px, 4vw, 24px);
      gap: 8px;
    }

    .hdr-brand {
      font-size: 20px;
    }

    .hdr-badge {
      font-size: 10px;
      padding: 4px 8px 5px;
    }

    /* Hide desktop nav/phone/cta */
    .hdr-nav,
    .hdr-phone,
    .hdr-cta {
      display: none;
    }

    /* Show burger */
    .hdr-burger {
      display: flex;
    }

    /* Show drawer container */
    .hdr-drawer {
      display: flex;
    }

    /* Open state */
    .hdr.open .hdr-drawer {
      max-height: 85vh;
      overflow-y: auto;
      padding-bottom: 24px;
    }

    .hdr.open .hdr-burger[aria-expanded] {
      /* for accessibility */
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.hdr');
    const burger = document.querySelector('.hdr-burger');
    const drawer = document.querySelector('.hdr-drawer');

    if (!header || !burger || !drawer) return;

    burger.addEventListener('click', () => {
      const isOpen = header.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(isOpen));
      drawer.setAttribute('aria-hidden', String(!isOpen));
    });

    // Close drawer on link click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        header.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
      });
    });

    // Close drawer on outside click
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node) && header.classList.contains('open')) {
        header.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
      }
    });
  });
</script>
