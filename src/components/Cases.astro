---
// Cases.astro
import { getAssetUrl } from '../utils/paths';

const casesList = [
  {
    num: 0,
    file: 'yandex_plus_live.mp4',
    title: 'Яндекс Плюс × сборная России',
    sub: 'Многокамерный прямой эфир матч-дня',
    cat: 'ТРАНСЛЯЦИЯ',
    time: '01:12',
    img: getAssetUrl('/assets/img/cases/yandex-plus.jpg'),
    alt: 'Студия эфира Яндекс Плюс: ведущие и гости на диванах'
  },
  {
    num: 1,
    file: 'medliga_hospital.mp4',
    title: 'Medliga: больница в Новосибирске',
    sub: 'Кейс-фильм о новом оборудовании в действующей клинике',
    cat: 'ИМИДЖЕВЫЙ',
    time: '02:30',
    img: null,
    alt: ''
  },
  {
    num: 2,
    file: 'dlb_ai_clip.mp4',
    title: 'Клип dlb и шоурил ИИ',
    sub: '3D-сканы артистов в сгенерированных мирах',
    cat: 'AI-ВИДЕО',
    time: '01:30',
    img: null,
    alt: ''
  },
  {
    num: 3,
    file: 'vetliga_review.mp4',
    title: 'Vetliga: обзор оборудования',
    sub: 'Презентационный ролик для B2B-продаж',
    cat: 'РЕКЛАМА',
    time: '01:45',
    img: null,
    alt: ''
  },
  {
    num: 4,
    file: 'cosmetics_product.mp4',
    title: 'Косметика: продуктовый ролик',
    sub: 'Один съёмочный день, две недели подготовки',
    cat: 'РЕКЛАМА',
    time: '00:45',
    img: null,
    alt: ''
  },
  {
    num: 5,
    file: 'dance_school_doc.mp4',
    title: 'Школа хореографии',
    sub: 'Документальный фильм к юбилею школы',
    cat: 'ДОКУМЕНТАЛЬНОЕ',
    time: '04:10',
    img: null,
    alt: ''
  }
];

const taskbarItems = [
  { title: 'Волжанка × ЦУМ', index: 0 },
  { title: 'Яндекс Плюс × сборная России', index: 1 },
  { title: 'Medliga: больница в Новосибирске', index: 2 },
  { title: 'Клип dlb и шоурил ИИ', index: 3 },
  { title: 'Vetliga: обзор оборудования', index: 4 },
  { title: 'Косметика: продуктовый ролик', index: 5 },
  { title: 'Школа хореографии', index: 6 }
];
---

<section id="kejsy" style="position: relative; background-color: #3358F4; background-image: radial-gradient(rgba(255,255,255,0.18) 1.5px, transparent 1.7px); background-size: 28px 28px; color: #FFFFFF; padding-top: 88px">
  <div style="max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px)">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px; margin-bottom: 40px">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.12em">01 · КЕЙСЫ</span>
        <h2 style="margin: 0; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 900; font-size: clamp(36px, 5vw, 68px); line-height: 1">КЕЙСЫ</h2>
      </div>
      <p style="margin: 0; max-width: 420px; font-size: 17px; line-height: 1.5">Семь работ, которыми гордимся. Наведите на окно — ролик оживёт, нажмите — откроем задачу, решение и результат.</p>
    </div>

    <!-- Главный кейс (Волжанка) -->
    <div class="casewin" style="background: #C3C3C3; padding: 4px; color: #1B1B1B; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF, 10px 10px 0 #10142E">
      <div class="tb" style="display: flex; align-items: center; gap: 8px; padding: 4px 4px 4px 8px; background: linear-gradient(90deg, #7B7B7B, #B5B5B5); color: #FFFFFF">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
          <rect x="1" y="3" width="14" height="10" fill="#E4E3DE"></rect>
          <polygon points="6,5.5 11,8 6,10.5" fill="#3358F4"></polygon>
        </svg>
        <span style="flex: 1 1 auto; min-width: 0; font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">volzhanka_cum.mp4 — Проигрыватель · громкий кейс</span>
        <span aria-hidden="true" style="display: flex; gap: 2px">
          <span style="display: flex; align-items: center; justify-content: center; width: 18px; height: 16px; background: #C3C3C3; color: #1B1B1B; font-size: 11px; font-weight: 800; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">_</span>
          <span style="display: flex; align-items: center; justify-content: center; width: 18px; height: 16px; background: #C3C3C3; color: #1B1B1B; font-size: 10px; font-weight: 800; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">□</span>
          <span style="display: flex; align-items: center; justify-content: center; width: 18px; height: 16px; background: #C3C3C3; color: #1B1B1B; font-size: 12px; font-weight: 800; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">×</span>
        </span>
      </div>
      <div aria-hidden="true" style="display: flex; gap: 16px; padding: 4px 6px; font-size: 13px">
        <span>Файл</span><span>Вид</span><span>Воспроизведение</span><span>Справка</span>
      </div>
      <div style="position: relative; aspect-ratio: 1588 / 600; overflow: hidden; background: #10142E; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #FFFFFF">
        <img class="poster" src={getAssetUrl('/assets/img/cases/volzhanka.jpg')} alt="3D-бутылка «Волжанки» выходит за края углового экрана ЦУМ" style="display: block; width: 100%; height: 100%; object-fit: cover" />
        <span aria-hidden="true" class="scanline" style="position: absolute; inset: 0; display: block; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,0) 44%, rgba(185,198,251,0.22) 50%, rgba(255,255,255,0) 56%)"></span>
        <span style="position: absolute; left: 14px; top: 14px; padding: 5px 9px; background: #1B1B1B; color: #E4E3DE; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.1em">3D-РОЛИК</span>
        <span aria-hidden="true" class="live" style="position: absolute; right: 14px; top: 14px; display: flex; align-items: center; gap: 6px; padding: 5px 9px; background: #3358F4; color: #FFFFFF; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.1em">
          <span class="blink" style="width: 7px; height: 7px; border-radius: 50%; background: #FFFFFF"></span>PLAY
        </span>
      </div>
      <span aria-hidden="true" style="display: block; height: 6px; margin: 6px 2px 0; background: #FFFFFF; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #DFDFDF">
        <span class="prog" style="display: block; height: 100%; background: #3358F4"></span>
      </span>
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; padding: 16px 10px 12px">
        <div style="display: flex; flex-direction: column; gap: 4px; min-width: 0">
          <span style="font-weight: 800; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.15">Волжанка × ЦУМ</span>
          <span style="font-size: 15px; color: #3A3A3A">3D-анаморф для углового LED-экрана ЦУМ, Ульяновск</span>
        </div>
        <button data-on-click="openFeatured" style="display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 20px; border: 0; background: #C3C3C3; color: #1B1B1B; font-family: inherit; font-weight: 800; font-size: 15px; cursor: pointer; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">
          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 10 10"><polygon points="1,0 10,5 1,10" fill="#1B1B1B"></polygon></svg>
          Открыть кейс
        </button>
      </div>
    </div>

    <!-- Сетка кейсов -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 28px; margin-top: 32px">
      {casesList.map((c) => (
        <div class="casewin" style="background: #C3C3C3; padding: 4px; color: #1B1B1B; display: flex; flex-direction: column; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF, 8px 8px 0 #10142E; min-width: 0">
          <div class="tb" style="display: flex; align-items: center; gap: 8px; padding: 4px 4px 4px 8px; background: linear-gradient(90deg, #7B7B7B, #B5B5B5); color: #FFFFFF">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
              <rect x="1" y="3" width="14" height="10" fill="#E4E3DE"></rect>
              <polygon points="6,5.5 11,8 6,10.5" fill="#3358F4"></polygon>
            </svg>
            <span style="flex: 1 1 auto; min-width: 0; font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">{c.file}</span>
            <span aria-hidden="true" style="display: flex; gap: 2px">
              <span style="display: flex; align-items: center; justify-content: center; width: 18px; height: 16px; background: #C3C3C3; color: #1B1B1B; font-size: 11px; font-weight: 800; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">_</span>
              <span style="display: flex; align-items: center; justify-content: center; width: 18px; height: 16px; background: #C3C3C3; color: #1B1B1B; font-size: 12px; font-weight: 800; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">×</span>
            </span>
          </div>
          <div class="scr" style="position: relative; aspect-ratio: 16 / 9; overflow: hidden; margin-top: 4px; background-color: #10142E; background-image: radial-gradient(rgba(185,198,251,0.22) 1px, transparent 1.3px); background-size: 12px 12px; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #FFFFFF">
            {c.img ? (
              <img class="poster" src={c.img} alt={c.alt} style="display: block; width: 100%; height: 100%; object-fit: cover" />
            ) : (
              <span style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 14px; color: #B9C6FB; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em">ПОСТЕР ИЗ KINESCOPE</span>
            )}
            <span style="position: absolute; left: 10px; top: 10px; padding: 4px 8px; background: #1B1B1B; color: #E4E3DE; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em">{c.cat}</span>
            <span aria-hidden="true" class="scanline" style="position: absolute; inset: 0; display: block; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,0) 44%, rgba(185,198,251,0.22) 50%, rgba(255,255,255,0) 56%)"></span>
            <span aria-hidden="true" class="live" style="position: absolute; right: 10px; top: 10px; display: flex; align-items: center; gap: 6px; padding: 4px 8px; background: #3358F4; color: #FFFFFF; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em">
              <span class="blink" style="width: 7px; height: 7px; border-radius: 50%; background: #FFFFFF"></span>PLAY
            </span>
            <button data-on-click={`grid.${c.num}.open`} aria-label={`Открыть кейс: ${c.title}`} style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; width: 68px; height: 52px; border: 0; padding: 0; background: #C3C3C3; cursor: pointer; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF, 5px 5px 0 #1B1B1B">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 26 26"><polygon points="6,3 23,13 6,23" fill="#1B1B1B"></polygon></svg>
            </button>
          </div>
          <div style="display: flex; flex-direction: column; gap: 4px; padding: 12px 8px 12px; flex: 1 1 auto">
            <span style="font-weight: 800; font-size: 18px; line-height: 1.2">{c.title}</span>
            <span style="font-size: 14px; line-height: 1.4; color: #3A3A3A">{c.sub}</span>
          </div>
          <span aria-hidden="true" style="display: block; height: 6px; margin: 0 2px 4px; background: #FFFFFF; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #DFDFDF">
            <span class="prog" style="display: block; height: 100%; background: #3358F4"></span>
          </span>
          <div style="display: flex; gap: 3px; font-size: 12px">
            <span style="flex: 1 1 auto; padding: 3px 6px; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #FFFFFF">{c.cat}</span>
            <span style="padding: 3px 8px; font-family: 'JetBrains Mono', monospace; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #FFFFFF">{c.time}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Панель задач Windows 95 -->
  <div style="margin-top: 64px; background: #C3C3C3; color: #1B1B1B; box-shadow: inset 0 1px 0 #DFDFDF, inset 0 2px 0 #FFFFFF; padding: 4px 0">
    <div style="max-width: 1280px; margin: 0 auto; padding: 2px clamp(16px, 4vw, 48px); display: flex; align-items: center; gap: 6px">
      <a href="#top" style="display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 12px; flex: 0 0 auto; background: #C3C3C3; color: #1B1B1B; text-decoration: none; font-weight: 800; font-size: 15px; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 200 200"><polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#3358F4" stroke="#3358F4" stroke-width="8" stroke-linejoin="round"></polygon></svg>
        Пуск
      </a>
      <span aria-hidden="true" style="width: 2px; height: 34px; margin: 0 4px; box-shadow: inset 1px 0 0 #7B7B7B, inset -1px 0 0 #FFFFFF; flex: 0 0 auto"></span>
      <div style="display: flex; gap: 4px; flex: 1 1 auto; min-width: 0; overflow-x: auto">
        {taskbarItems.map((item) => (
          <button
            data-on-click={`tasks.${item.index}.open`}
            style="flex: 0 0 auto; max-width: 200px; height: 44px; padding: 0 12px; border: 0; background: #C3C3C3; color: #1B1B1B; font-family: inherit; font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF"
            data-b-style={`tasks.${item.index}.style`}
          >
            {item.title}
          </button>
        ))}
      </div>
      <span style="flex: 0 0 auto; padding: 0 12px; height: 34px; display: flex; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; box-shadow: inset 1px 1px 0 #7B7B7B, inset -1px -1px 0 #FFFFFF">
        <span data-b-text="clock">00:15</span>
      </span>
    </div>
  </div>

  <!-- Модальное окно свойств кейса -->
  <span data-if="showCase" style="display: none">
    <div style="position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(16, 20, 46, 0.72)">
      <div role="dialog" aria-modal="true" aria-label="Волжанка × ЦУМ" data-b-aria-label="dlg.title" style="width: min(100%, 640px); max-height: calc(100vh - 32px); overflow: auto; background: #C3C3C3; padding: 4px; color: #1B1B1B; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF, 12px 12px 0 #10142E">
        <div style="display: flex; align-items: center; gap: 8px; padding: 4px 4px 4px 8px; background: linear-gradient(90deg, #10142E, #3358F4); color: #FFFFFF">
          <span style="flex: 1 1 auto; min-width: 0; font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis">Свойства: <span data-b-text="dlg.title">Волжанка × ЦУМ</span></span>
          <button data-on-click="closeCase" aria-label="Закрыть" style="display: flex; align-items: center; justify-content: center; width: 28px; height: 24px; border: 0; padding: 0; background: #C3C3C3; color: #1B1B1B; font-family: inherit; font-size: 15px; font-weight: 800; cursor: pointer; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">×</button>
        </div>
        <div style="padding: 16px 14px 14px; display: flex; flex-direction: column; gap: 16px">
          <div style="display: flex; flex-direction: column; gap: 4px">
            <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em; color: #3A3A3A">
              <span data-b-text="dlg.cat">3D-РОЛИК</span> · <span data-b-text="dlg.time">[ХРОН]</span>
            </span>
            <span style="font-weight: 800; font-size: 22px; line-height: 1.2"><span data-b-text="dlg.title">Волжанка × ЦУМ</span></span>
            <span style="font-size: 15px; color: #3A3A3A"><span data-b-text="dlg.sub">3D-анаморф для углового LED-экрана ЦУМ, Ульяновск</span></span>
          </div>
          <div style="position: relative; padding: 16px 12px 12px; border: 1px solid #7B7B7B; box-shadow: 1px 1px 0 #FFFFFF, inset 1px 1px 0 #FFFFFF">
            <span style="position: absolute; top: -10px; left: 10px; padding: 0 5px; background: #C3C3C3; font-weight: 700; font-size: 13px">Задача</span>
            <p style="margin: 0; font-size: 15px; line-height: 1.5"><span data-b-text="dlg.task">Остановить прохожих у ЦУМа и заставить их снимать экран на телефон.</span></p>
          </div>
          <div style="position: relative; padding: 16px 12px 12px; border: 1px solid #7B7B7B; box-shadow: 1px 1px 0 #FFFFFF, inset 1px 1px 0 #FFFFFF">
            <span style="position: absolute; top: -10px; left: 10px; padding: 0 5px; background: #C3C3C3; font-weight: 700; font-size: 13px">Решение</span>
            <p style="margin: 0; font-size: 15px; line-height: 1.5"><span data-b-text="dlg.sol">3D-ролик с эффектом объёма: бутылка «выходит» за края углового экрана. Собрали в Blender под точку обзора площадки.</span></p>
          </div>
          <div style="position: relative; padding: 16px 12px 12px; border: 1px solid #7B7B7B; box-shadow: 1px 1px 0 #FFFFFF, inset 1px 1px 0 #FFFFFF">
            <span style="position: absolute; top: -10px; left: 10px; padding: 0 5px; background: #C3C3C3; font-weight: 700; font-size: 13px">Результат</span>
            <p style="margin: 0; font-size: 15px; line-height: 1.5"><span data-b-text="dlg.res">[Впишите результат: охваты, упоминания, отзыв клиента]</span></p>
          </div>
          <div style="display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px">
            <a href="#kejsy" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; background: #C3C3C3; color: #1B1B1B; text-decoration: none; font-weight: 800; font-size: 14px; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF">
              <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10"><polygon points="1,0 10,5 1,10" fill="#1B1B1B"></polygon></svg>
              Смотреть ролик
            </a>
            <button data-on-click="closeCase" style="min-height: 44px; min-width: 96px; padding: 0 18px; border: 0; background: #C3C3C3; color: #1B1B1B; font-family: inherit; font-weight: 800; font-size: 14px; cursor: pointer; box-shadow: inset -1px -1px 0 #0A0A0A, inset 1px 1px 0 #FFFFFF, inset -2px -2px 0 #7B7B7B, inset 2px 2px 0 #DFDFDF, 0 0 0 1px #1B1B1B">ОК</button>
          </div>
        </div>
      </div>
    </div>
  </span>
</section>
