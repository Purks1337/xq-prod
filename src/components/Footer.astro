---
// Footer.astro
import { getAssetUrl } from '../utils/paths';

const servicesFooter = [
  { title: 'Имиджевый ролик', url: getAssetUrl('/uslugi/imidzhevyj-rolik/') },
  { title: 'Рекламный ролик', url: getAssetUrl('/uslugi/reklamnyj-rolik/') },
  { title: 'AI-видео', url: getAssetUrl('/uslugi/ai-video/') },
  { title: 'Документальный фильм', url: getAssetUrl('/uslugi/dokumentalnyj-film/') },
  { title: '3D-ролики', url: getAssetUrl('/uslugi/3d-rolik/') },
  { title: 'Онлайн-трансляции', url: getAssetUrl('/uslugi/onlajn-translyaciya/') }
];
---

<footer style="background: #1B1B1B; color: #E4E3DE; padding: 64px 0 32px">
  <div style="max-width: 1080px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); display: flex; flex-direction: column; gap: 40px">
    <div class="footer-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 32px">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <a href={getAssetUrl('/')} style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: #E4E3DE">
          <span style="display: flex; align-items: baseline; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 900; font-size: 24px; line-height: 1; letter-spacing: -0.02em; gap: 0.05em">
            <svg aria-hidden="true" width="0.82em" height="0.82em" viewBox="0 0 200 200" style="display: block; flex: 0 0 auto; margin-right: 0.22em">
              <polygon points="12,12 100,64 188,12 136,100 188,188 100,136 12,188 64,100" fill="#3358F4" stroke="#3358F4" stroke-width="8" stroke-linejoin="round"></polygon>
            </svg>
            <span>ХВАЛИТЕ</span>
          </span>
          <span style="padding: 5px 10px 6px; border-radius: 999px; background: #3358F4; color: #FFFFFF; font-family: 'Unbounded', 'Arial Black', sans-serif; font-weight: 800; font-size: 11px">MEDIA</span>
        </a>
        <span style="font-size: 14px; line-height: 1.5; color: #A8A7A2">Онлайн-продакшн полного цикла. Снимаем так, что хвалят.</span>
        <div style="font-size: 12px; line-height: 1.6; color: #7E7D78; margin-top: 4px">
          ИП Аккерман Марк Эдуардович<br>
          ИНН 661711760816<br>
          ОГРНИП 322665800067998
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px">
        <a href={getAssetUrl('/uslugi/')} style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; color: #A8A7A2; text-decoration: none">УСЛУГИ →</a>
        {servicesFooter.map(s => (
          <a href={s.url} style="color: #E4E3DE; text-decoration: none; transition: color 0.15s">{s.title}</a>
        ))}
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px">
        <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; color: #A8A7A2">РАЗДЕЛЫ</span>
        <a href="#kejsy" style="color: #E4E3DE; text-decoration: none">Кейсы</a>
        <a href={getAssetUrl('/uslugi/')} style="color: #E4E3DE; text-decoration: none">Каталог услуг</a>
        <a href="#process" style="color: #E4E3DE; text-decoration: none">Как работаем</a>
        <a href="#zayavka" style="color: #E4E3DE; text-decoration: none">Заявка</a>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px">
        <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; color: #A8A7A2">КОНТАКТЫ</span>
        <a href="tel:+79022775570" style="color: #E4E3DE; text-decoration: none">+7 902 277 55 70</a>
        <a href="mailto:hvalitemedia@gmail.com" style="color: #E4E3DE; text-decoration: none">hvalitemedia@gmail.com</a>
        <span>Екатеринбург, ул. Ботаническая, 19</span>
        <span style="font-size: 12px; color: #7E7D78">Онлайн-студия · Приём заявок 24/7</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px">
        <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; color: #A8A7A2">СОЦСЕТИ</span>
        <a href="https://t.me/hvalitemedia" target="_blank" rel="noopener noreferrer" style="color: #E4E3DE; text-decoration: none">Telegram</a>
        <a href="https://wa.me/message/FTUPFBI5PTVXM1" target="_blank" rel="noopener noreferrer" style="color: #E4E3DE; text-decoration: none">WhatsApp</a>
        <a href="https://vk.ru/hvalitemedia" target="_blank" rel="noopener noreferrer" style="color: #E4E3DE; text-decoration: none">ВКонтакте</a>
        <a href="https://www.instagram.com/hvalite_media" target="_blank" rel="noopener noreferrer" style="color: #E4E3DE; text-decoration: none">Instagram</a>
        <a href="https://max.ru/u/f9LHodD0cOJlKJD7_H4cAo2_YvP5zo4I4avnmkRYVL4s5P1zzELtY8c8xPA" target="_blank" rel="noopener noreferrer" style="color: #E4E3DE; text-decoration: none">MAX</a>
      </div>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-top: 24px; border-top: 1px solid #3A3A3A; font-size: 13px; color: #A8A7A2">
      <span>© 2026 Хвалите Media · ИП Аккерман М.Э.</span>
      <div style="display: flex; flex-wrap: wrap; gap: 16px">
        <a href={getAssetUrl('/privacy/')} style="color: #A8A7A2; text-decoration: none">Политика конфиденциальности</a>
        <a href={getAssetUrl('/privacy/#consent')} style="color: #A8A7A2; text-decoration: none">Согласие на обработку данных</a>
        <a href={getAssetUrl('/privacy/#cookies')} style="color: #A8A7A2; text-decoration: none">Куки</a>
      </div>
    </div>
  </div>
</footer>
